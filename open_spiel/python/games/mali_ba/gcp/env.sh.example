# Copy this file to env.sh (already gitignored) and fill in your own values,
# then it will be sourced automatically by the other gcp/*.sh scripts.
#
#   cp env.sh.example env.sh
#   $EDITOR env.sh

export GCP_PROJECT_ID="mali-ba-training"      # your GCP project ID
export GCP_ZONE="us-central1-a"
export GCP_NETWORK="default"                  # VPC network name

export MAIN_VM_NAME="mali-ba-main"
export MAIN_VM_MACHINE_TYPE="n1-standard-8"
export MAIN_VM_GPU_TYPE="nvidia-tesla-t4"
export MAIN_VM_DISK_SIZE_GB=150

export WORKER_VM_MACHINE_TYPE="n2-custom-16-24576"  # 16 vCPU / 24GB custom -- see create_worker_vm.sh comment
export WORKER_VM_DISK_SIZE_GB=50
# Set after running create_worker_image.sh once, to skip the ~20-40 min
# OpenSpiel build on every new worker. Leave unset to use stock Ubuntu.
# export WORKER_IMAGE_FAMILY="mali-ba-worker-base"

export QUEUE_PORT=50000
export AUTHKEY="changeme-shared-secret"        # must match on main-vm and all workers

# Reusable Tailscale auth key (Tailscale admin console > Settings > Keys --
# must be marked Reusable). Lets workers authenticate automatically instead
# of a manual "sudo tailscale up" + browser click per worker. Run
# set_tailscale_authkey.sh after setting this to push it to GCP project
# metadata. Keys expire (90 days by default) -- regenerate when workers start
# reporting "NOT authenticated" in their MOTD banner.
export TS_AUTHKEY="tskey-auth-changeme"
